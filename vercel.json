{
  "buildCommand": "node scripts/build-production.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/managed-property-palm-services.html",
      "destination": "/palm-records-monitoring-verification.html#organization-inquiry",
      "permanent": true
    },
    {
      "source": "/residential-palm-assessment.html",
      "destination": "/palm-records-monitoring-verification.html#homeowner-inquiry",
      "permanent": true
    },
    {
      "source": "/background.jpg",
      "destination": "/images/old-escondido-ufmp/john-krause-with-mature-cidp.jpg",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sandiegopalmprotection.com"
        }
      ],
      "destination": "https://www.sandiegopalmprotection.com/$1",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "southamericanpalmweevil.com"
        }
      ],
      "destination": "https://www.sandiegopalmprotection.com/sapw.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.southamericanpalmweevil.com"
        }
      ],
      "destination": "https://www.sandiegopalmprotection.com/sapw.html",
      "permanent": true
    },

    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sandiegopalmhealth.com"
        }
      ],
      "destination": "https://www.sandiegopalmprotection.com/palm-faq-san-diego.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.sandiegopalmhealth.com"
        }
      ],
      "destination": "https://www.sandiegopalmprotection.com/palm-faq-san-diego.html",
      "permanent": true
    },

    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sandiegopalmcare.com"
        }
      ],
      "destination": "https://www.sandiegopalmprotection.com/quarterly-palm-care-san-diego.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.sandiegopalmcare.com"
        }
      ],
      "destination": "https://www.sandiegopalmprotection.com/quarterly-palm-care-san-diego.html",
      "permanent": true
    }
  ]
}
