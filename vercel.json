{
  "buildCommand": "node scripts/build-production.mjs",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/managed-property-palm-services.html$",
      "status": 308,
      "headers": {
        "Location": "/palm-records-monitoring-verification.html#organization-inquiry"
      }
    },
    {
      "src": "^/residential-palm-assessment.html$",
      "status": 308,
      "headers": {
        "Location": "/palm-records-monitoring-verification.html#homeowner-inquiry"
      }
    },
    {
      "src": "^/background.jpg$",
      "status": 308,
      "headers": {
        "Location": "/images/old-escondido-ufmp/john-krause-with-mature-cidp.jpg"
      }
    },
    {
      "src": "^/(.*)$",
      "status": 301,
      "headers": {
        "Location": "https://www.sandiegopalmprotection.com/$1"
      },
      "has": [
        {
          "type": "host",
          "value": "sandiegopalmprotection.com"
        }
      ]
    },
    {
      "src": "^/$",
      "status": 308,
      "headers": {
        "Location": "https://www.sandiegopalmprotection.com/palm-faq-san-diego.html"
      },
      "has": [
        {
          "type": "host",
          "value": "sandiegopalmhealth.com"
        }
      ]
    },
    {
      "src": "^/$",
      "status": 308,
      "headers": {
        "Location": "https://www.sandiegopalmprotection.com/palm-faq-san-diego.html"
      },
      "has": [
        {
          "type": "host",
          "value": "www.sandiegopalmhealth.com"
        }
      ]
    },
    {
      "src": "^/$",
      "status": 308,
      "headers": {
        "Location": "https://www.sandiegopalmprotection.com/quarterly-palm-care-san-diego.html"
      },
      "has": [
        {
          "type": "host",
          "value": "sandiegopalmcare.com"
        }
      ]
    },
    {
      "src": "^/$",
      "status": 308,
      "headers": {
        "Location": "https://www.sandiegopalmprotection.com/quarterly-palm-care-san-diego.html"
      },
      "has": [
        {
          "type": "host",
          "value": "www.sandiegopalmcare.com"
        }
      ]
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "southamericanpalmweevil.com"
        }
      ],
      "dest": "/sapw.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "www.southamericanpalmweevil.com"
        }
      ],
      "dest": "/sapw.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
